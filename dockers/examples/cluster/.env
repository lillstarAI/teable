BACKEND_CACHE_PROVIDER={{project.BACKEND_CACHE_PROVIDER}}
BACKEND_CACHE_REDIS_URI={{project.BACKEND_CACHE_REDIS_URI}}

# Replace <MINIO_ENDPOINT> when using minio.
# For intranet: replace with the ip of the host where minio is currently deployed.
# For extranet: replace with minio's domain name or extranet ip.
BACKEND_STORAGE_PROVIDER={{project.BACKEND_STORAGE_PROVIDER}}
BACKEND_STORAGE_PUBLIC_BUCKET={{project.BACKEND_STORAGE_PUBLIC_BUCKET}}
BACKEND_STORAGE_PRIVATE_BUCKET={{project.BACKEND_STORAGE_PRIVATE_BUCKET}}
BACKEND_STORAGE_MINIO_ENDPOINT={{project.BACKEND_STORAGE_MINIO_ENDPOINT}}
BACKEND_STORAGE_MINIO_PORT={{project.BACKEND_STORAGE_MINIO_PORT}}
BACKEND_STORAGE_MINIO_USE_SSL={{project.BACKEND_STORAGE_MINIO_USE_SSL}}
BACKEND_STORAGE_MINIO_ACCESS_KEY={{project.BACKEND_STORAGE_MINIO_ACCESS_KEY}}
BACKEND_STORAGE_MINIO_SECRET_KEY={{project.BACKEND_STORAGE_MINIO_SECRET_KEY}}
STORAGE_PREFIX={{project.BACKEND_STORAGE_MINIO_ENDPOINT}}

# Need to support sending emails to enable the following configurations
# You need to modify the configuration according to the actual situation, otherwise it will not be able to send emails correctly.
BACKEND_MAIL_HOST={{project.BACKEND_MAIL_HOST}}
BACKEND_MAIL_PORT={{project.BACKEND_MAIL_PORT}}
BACKEND_MAIL_SECURE={{project.BACKEND_MAIL_SECURE}}
BACKEND_MAIL_SENDER={{project.BACKEND_MAIL_SENDER}}
BACKEND_MAIL_SENDER_NAME={{project.BACKEND_MAIL_SENDER_NAME}}
BACKEND_MAIL_AUTH_USER={{project.BACKEND_MAIL_AUTH_USER}}
BACKEND_MAIL_AUTH_PASS={{project.BACKEND_MAIL_AUTH_PASS}}

I18NEXT_DEFAULT_CONFIG_PATH={{project.I18NEXT_DEFAULT_CONFIG_PATH}}
