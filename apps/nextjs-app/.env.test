# ↓↓↓↓↓↓↓↓ frontend（nextjs） env ↓↓↓↓↓↓↓↓


# ↓↓↓↓↓↓↓↓ backend（nestjs） env ↓↓↓↓↓↓↓↓
NEXTJS_DIR={project.NEXTJS_DIR}
TEST_LOG_LEVEL={project.TEST_LOG_LEVEL}
PORT={project.PORT}
SOCKET_PORT={project.SOCKET_PORT}

PUBLIC_ORIGIN={project.PUBLIC_ORIGIN}

# static assets url prefix
ASSET_PREFIX={project.ASSET_PREFIX}
# storage service url prefix
STORAGE_PREFIX={project.STORAGE_PREFIX}

# DATABASE_URL
# @see https://www.prisma.io/docs/reference/database-reference/connection-urls#examples
PRISMA_DATABASE_URL={project.PRISMA_DATABASE_URL}
PUBLIC_DATABASE_PROXY={project.PUBLIC_DATABASE_PROXY}
BACKEND_CACHE_PROVIDER={project.BACKEND_CACHE_PROVIDER}

ENABLE_GLOBAL_ERROR_LOGGING={project.ENABLE_GLOBAL_ERROR_LOGGING}
API_DOC_DISENABLED={project.API_DOC_DISENABLED}
