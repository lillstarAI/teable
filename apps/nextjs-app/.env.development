#######################################################################################
# BUILD ENVIRONMENT - Consumed by next.config.mjs during build and development     #
#######################################################################################
NEXT_BUILD_ENV_CSP={{project.NEXT_BUILD_ENV_CSP}}
NEXT_BUILD_ENV_SENTRY_ENABLED={{project.NEXT_BUILD_ENV_SENTRY_ENABLED}}
NEXT_BUILD_ENV_SENTRY_UPLOAD_DRY_RUN={{project.NEXT_BUILD_ENV_SENTRY_UPLOAD_DRY_RUN}}
#######################################################################################

# ↓↓↓↓↓↓↓↓ frontend（nextjs） env ↓↓↓↓↓↓↓↓
NEXT_ENV_IMAGES_ALL_REMOTE={{project.NEXT_ENV_IMAGES_ALL_REMOTE}}

# ↓↓↓↓↓↓↓↓ backend（nestjs） env ↓↓↓↓↓↓↓↓
NEXTJS_DIR={{project.NEXTJS_DIR}}
LOG_LEVEL={{project.LOG_LEVEL}}
PORT={{project.PORT}}
SOCKET_PORT={{project.SOCKET_PORT}}

PUBLIC_ORIGIN={{project.PUBLIC_ORIGIN}}

# storage service url prefix
STORAGE_PREFIX={{project.STORAGE_PREFIX}}

# DATABASE_URL
# @see https://www.prisma.io/docs/reference/database-reference/connection-urls#examples
PRISMA_DATABASE_URL={{project.PRISMA_DATABASE_URL}}
PUBLIC_DATABASE_PROXY={{project.LOCALHOST}}:5432

API_DOC_DISENABLED={{project.API_DOC_DISENABLED}}
API_DOC_ENABLED_SNIPPET={{project.API_DOC_ENABLED_SNIPPET}}
