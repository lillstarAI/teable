#######################################################################################
# 1. BUILD ENVIRONMENT - Consumed by next.config.mjs during build and development     #
#######################################################################################
NEXT_BUILD_ENV_OUTPUT=classic
NEXT_BUILD_ENV_SOURCEMAPS=true
NEXT_BUILD_ENV_LINT=true
NEXT_BUILD_ENV_TYPECHECK=true
NEXT_BUILD_ENV_CSP={{project.NEXT_BUILD_ENV_CSP}}
NEXT_BUILD_ENV_SENTRY_ENABLED={{project.NEXT_BUILD_ENV_SENTRY_ENABLED}}
NEXT_BUILD_ENV_SENTRY_UPLOAD_DRY_RUN={{project.BUILD_TIME}}
NEXT_BUILD_ENV_SENTRY_DEBUG=true
NEXT_BUILD_ENV_SENTRY_TRACING=true

NEXT_PUBLIC_BUILD_VERSION={{project.NEXT_PUBLIC_BUILD_VERSION}}
BUILD_VERSION={{project.BUILD_VERSION}}
#######################################################################################

# ↓↓↓↓↓↓↓↓ frontend（nextjs） env ↓↓↓↓↓↓↓↓
NEXT_PUBLIC_SENTRY_DSN=true
NEXT_ENV_IMAGES_ALL_REMOTE={{project.NEXT_ENV_IMAGES_ALL_REMOTE}}


# ↓↓↓↓↓↓↓↓ backend（nestjs） env ↓↓↓↓↓↓↓↓
DATABASE_URL=${project.DATABASE_URL}
# When deploying on serveless/lambdas "?connection_limit=" should be 1
# @see https://www.prisma.io/docs/concepts/components/prisma-client/deployment#recommended-connection-limit
PRISMA_DATABASE_URL={{project.PRISMA_DATABASE_URL}}
LOCALHOST={{project.LOCALHOST}}
SENTRY_DSN=true

# See https://github.com/soluble-io/cache-interop
APP_CACHE_DSN=true

LOG_LEVEL={{project.LOG_LEVEL}}

NEXTJS_DIR={{project.NEXTJS_DIR}}
PORT={{project.PORT}}
SOCKET_PORT={{project.SOCKET_PORT}}


BRAND_NAME=Teable
API_DOC_ENABLED_SNIPPET={{project.API_DOC_ENABLED_SNIPPET}}
API_DOC_DISENABLED={{project.API_DOC_DISENABLED}}

I18NEXT_DEFAULT_CONFIG_PATH={{project.I18NEXT_DEFAULT_CONFIG_PATH}}
